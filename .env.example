# Caminho do currículo (PDF ou DOCX)
RESUME_PATH=meu_cv.pdf

# Busca
SEARCH_KEYWORDS=desenvolvedor python
SEARCH_LOCATION=Brasil
SEARCH_REMOTE=true

# Fontes de vagas (separadas por vírgula):
# linkedin, gupy, infojobs, remotive, remoteok, indeed, greenhouse, solides, trampos,
# jooble, catho, vagascom, careerjet, trabalhabrasil, empregoscom
SEARCH_SOURCES=gupy,solides,trampos,catho,empregoscom

# Jooble — agregador (Catho, Vagas.com, etc.) — cadastro grátis em jooble.org/api/about
JOOBLE_API_KEY=

# CareerJet — agregador — cadastro em careerjet.com.br/partners
CAREERJET_API_KEY=

# Filtros avançados (deixe vazio para "qualquer")
# Workplace: remoto, hibrido, presencial
SEARCH_WORKPLACE=
# Tipo de vaga: efetivo, estagio, meio_periodo, temporario, pj
SEARCH_JOB_TYPE=
# Nível: estagio, junior, pleno, senior, diretor, executivo
SEARCH_EXPERIENCE=
# Data de publicação: 24h, semana, mes, qualquer
SEARCH_DATE_POSTED=qualquer

# Limites
DAILY_APPLY_LIMIT=10
MIN_MATCH_SCORE=60
TOP_JOBS_TO_SHOW=20

# Matching
USE_SEMANTIC_MATCHING=true

# Idioma da carta: auto (detecta pela vaga) | pt | en
COVER_LETTER_LANG=auto

# LLM opcional (desligado por padrão)
# Valores: none | ollama | groq
LLM_PROVIDER=none
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Playwright
BROWSER_DATA_DIR=browser_data
HEADLESS=false

# Armazenamento
DATA_DIR=data
# Retenção dos arquivos enviados pela interface web (em horas)
UPLOAD_RETENTION_HOURS=24

# Interface web — limites e segurança
# Tamanho máximo do currículo enviado (MB)
MAX_UPLOAD_MB=8
# PIN opcional para proteger a UI em LAN (deixe vazio para desligar)
WEB_ACCESS_PIN=
# Notificações de alertas
NOTIFY_DESKTOP=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=
# Rate limiting por sessão (janela de 60s)
RATE_LIMIT_MAX=30
SEARCH_RATE_MAX=8
